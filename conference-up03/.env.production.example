# Requires HTTPS reverse proxy and a NEW database, never the demo database.
APP_ENV=production
DEMO_MODE=false
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_PATH=data/production.db
ALLOWED_HOSTS=conference.example.com,localhost,127.0.0.1
COOKIE_SECURE=true
# Set a unique password of at least 14 characters before first startup.
ADMIN_PASSWORD=
